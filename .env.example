# LLM keys are optional: with neither set, the app runs in mock LLM mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local docker-compose database: postgres://leadpilot:leadpilot@localhost:5432/leadpilot
DATABASE_URL=
# Shared secret for signing contact-center webhooks: any long random string locally
WEBHOOK_SECRET=
# Bearer token required by /api/cron/* routes (Vercel Cron sends it automatically)
CRON_SECRET=

# Optional overrides
# LLM_MOCK=true
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5-mini
# APP_URL=http://localhost:3000   # where scripts/send-mock-webhook.ts sends events
